{
  "manifest_version": 3,
  "name": "BC helperis",
  "version": "1.2.5",
  "description": "Ērts palīgs AM Furnitūra komandai: ātra preču un daudzumu atlase no eamf.lv ievietošanai Business Central.",
  "permissions": [
    "storage",
    "contextMenus",
    "tabs",
    "clipboardWrite"
  ],
  "host_permissions": [
    "*://*.eamf.lv/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.eamf.lv/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*"
      ],
      "matches": [
        "*://*.eamf.lv/*"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "BC helperis",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
